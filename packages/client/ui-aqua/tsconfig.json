{
  "extends": "../../../tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"],
    // The absorbed upstream rendering engines (mesh.ts, whale.ts) index their
    // physics arrays without element guards throughout; tightening them would
    // rewrite absorbed code with no behavioral gain. Everything else — the
    // persistence seams, the runtime, the components — stays fully strict.
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src"
  ],
  "references": [
    { "path": "../locale" },
    { "path": "../runtime" },
    { "path": "../ui-slots" },
    { "path": "../ui-settings" },
    { "path": "../ui-settings-plugins" },
    { "path": "../ui-theme" },
    { "path": "../ui-primitives" },
    { "path": "../connection/tsconfig.host.json" },
    { "path": "../../attachment/attachment" },
    { "path": "../../host/webserver" },
    { "path": "../../settings/settings" },
    { "path": "../../runtime-diagnostics/invariants" },
    { "path": "../../../vendor/cordis" }
  ]
}
